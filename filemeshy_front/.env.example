# ==================== API Configuration ====================
# URL del backend de FileMeshy
# Docker expone el backend en puerto 52101 (mapea 52101 -> 8000 interno)
# - Desarrollo (Docker): http://localhost:52101/api/v1
# - Producción: (definir dominio cuando exista despliegue)
VITE_API_URL=http://localhost:52101/api/v1

# Tiempo máximo de espera para peticiones API (en milisegundos)
VITE_API_TIMEOUT=30000

# ==================== Application ====================
# Nombre de la aplicación
VITE_APP_NAME=FileMeshy

# Versión de la aplicación
VITE_APP_VERSION=1.0.0

# Entorno (development | production)
VITE_APP_ENV=development

# ==================== Authentication (OAuth 2.0) ====================
# NOTA: Con OAuth 2.0 y httpOnly cookies, los tokens NO se guardan en localStorage
# Access token: en memoria (authService)
# Refresh token: httpOnly cookie (backend)
# Estas variables solo se usan como fallback en env.ts

VITE_TOKEN_KEY=filemeshy_token
VITE_REFRESH_TOKEN_KEY=filemeshy_refresh_token

# ==================== Features ====================
# Habilitar logs de debug en consola
VITE_DEBUG=true
