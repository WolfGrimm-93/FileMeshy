# Variables usadas directamente por docker-compose.prod.yml (raíz del repo).
# Copiar a `.env` junto al compose en el servidor y completar con valores reales
# generados ahí -- nunca versionar el `.env` real (ya está en .gitignore).
#
# Generar cada secreto con: python -c "import secrets; print(secrets.token_urlsafe(32))"

POSTGRES_PASSWORD=
MINIO_SECRET_KEY=
