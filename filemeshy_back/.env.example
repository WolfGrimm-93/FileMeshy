# ===== APP SETTINGS =====
ENVIRONMENT=development  # development, staging, production
DEBUG=True
PROJECT_NAME=FileMeshy API
PROJECT_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# ===== DATABASE =====
# PostgreSQL — puerto 58104 si corrés vía docker compose (ver docker-compose.yml)
DATABASE_URL=postgresql://user:password@localhost:58104/filemeshy

# MySQL (alternativa)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/filemeshy

# ===== JWT SECURITY =====
# CRÍTICO: Cambiar en producción!
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== SERVER =====
HOST=0.0.0.0
PORT=8888

# ===== CORS =====
BACKEND_CORS_ORIGINS=["http://localhost:58100","http://localhost:5173","http://localhost:1420"]

# ===== EMAIL / SMTP =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@filemeshy.local

# ===== SECURITY - RATE LIMITING (P0) =====
# Protección contra ataques de fuerza bruta en password reset
RATE_LIMIT_ENABLED=True
RATE_LIMIT_MAX_ATTEMPTS=3      # Máximo intentos fallidos (default: 3)
RATE_LIMIT_LOCK_DURATION=900   # 15 minutos en segundos (900s = 15 min)

# ===== SECURITY - COOKIES (P0) =====
# Si no se setea, se auto-detecta: True en production, False en otros entornos.
# Setear explícitamente para sobreescribir el auto-detect:
#   COOKIE_SECURE=True  → requerido cuando el frontend usa HTTPS
#   COOKIE_SECURE=False → cuando el acceso es solo por LAN sin HTTPS (ej: http://192.168.x.x)
# COOKIE_SECURE=False
COOKIE_SAMESITE=strict          # strict para password-reset, lax para login

# ===== MINIO (Almacenamiento de imágenes y archivos) =====
# MINIO_ENDPOINT: URL interna desde donde FastAPI sube archivos
#   - Docker: http://minio:9000 (docker-compose.yml lo sobreescribe así)
#   - Local (sin Docker): http://localhost:58102
MINIO_ENDPOINT=http://localhost:58102
MINIO_ACCESS_KEY=filemeshy_minio_admin
MINIO_SECRET_KEY=filemeshy_minio_dev_only
MINIO_BUCKET=filemeshy-media
# MINIO_PUBLIC_URL: URL accesible desde el navegador (donde el front lee las imágenes)
MINIO_PUBLIC_URL=http://localhost:58102
# MINIO_PRIVATE_BUCKET: bucket SIN política pública, para PII (documentos de
# identidad de usuarios) -- se sirve solo con URL firmada de corta duración, nunca URL directa
MINIO_PRIVATE_BUCKET=filemeshy-media-private

# ===== TENANT (Identificador de empresa para almacenamiento) =====
# En modo cloud se setea por instalador. En modo local, "default" si no se setea.
# TENANT_SLUG=

# ===== MULTI-TENANCY (Fase 2 - fundacion) =====
# "local": single-tenant, comportamiento actual (default, no negociable -- no
#          setear esta variable, o dejarla en "local", para instalaciones existentes).
# "cloud": multi-tenant, habilita TenantMiddleware y el search_path dinamico.
DEPLOYMENT_MODE=local

# ===== PLATAFORMA (Fase 3 - alta y config de tenants) =====
# Secreto para el header X-Platform-Key de /api/v1/platform/*. Solo importa en
# DEPLOYMENT_MODE=cloud -- en modo local esos endpoints ni se registran.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# PLATFORM_API_KEY=

