# Cada subproyecto (filemeshy_back/, filemeshy_front/) tiene su propio
# .gitignore con las reglas específicas de su stack. Este archivo es solo
# para lo que puede aparecer en la raíz o como red de seguridad general.

# Variables de entorno (nunca subir secretos reales)
.env
.env.local
.env.*.local
!.env.example

# Dependencias (red de seguridad — cada subproyecto ya las ignora también)
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Builds
dist/
build/

# Logs
*.log

# Editores
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Worktrees de git (.claude/worktrees/<nombre>/) — copias de trabajo locales,
# nunca se versionan
.claude/

# Notas de Claude Code e infraestructura real de producción (dominio, topología
# de despliegue, rutas a otros proyectos del mismo servidor) — no van a un repo
# que pueda hacerse público
CLAUDE.md
docker-compose.prod.yml

# Override de solo test/dev para probar modo cloud (multi-tenant) en local --
# Docker Compose lo mergea automáticamente sin -f, así que NUNCA debe
# comitearse: activaría DEPLOYMENT_MODE=cloud (y exige X-Tenant-Slug en toda
# request via TenantMiddleware) para cualquiera que clone el repo y levante
# el stack, rompiendo el modo local normal + la suite de tests existente
# (ver pendiente.md, Ronda 8). Se genera puntualmente cuando hace falta
# probar el panel de plataforma, se borra después.
docker-compose.override.yml
